datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  PLATFORM_OWNER
  SUPER_ADMIN
  MODERATOR
  SUPPORT_AGENT
  BUYER
  WORKER
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  RESTRICTED
  SUSPENDED
  BANNED
}

enum IdvStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
  MANUAL_REVIEW
}

enum TaskModel {
  MULTI_WORKER
  FIRST_APPROVED
}

enum TaskStatus {
  DRAFT
  PUBLISHED
  OPEN
  FULL
  PAUSED
  CLOSED
  COMPLETED
  CANCELLED
}

enum ParticipationStatus {
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUESTED
  REVIEW_OVERDUE
  APPROVED
  REJECTED
  DISPUTED
  ABANDONED
  CANCELLED
  FIRST_APPROVED_CLOSED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  EVIDENCE_SUBMITTED
  RESOLVED
  APPEALED
  DISMISSED
}

enum DemoAccountType {
  DEMO_SYSTEM_FAUCET_POOL
  DEMO_SYSTEM_REVENUE
  DEMO_BUYER_AVAILABLE
  DEMO_BUYER_ESCROW_RESERVED
  DEMO_WORKER_AVAILABLE
  DEMO_WORKER_PENDING_DISPUTE
}

enum RealAccountType {
  SYSTEM_COMMISSION_REVENUE
  SYSTEM_ESCROW_HOLDING
  SYSTEM_PAYMENT_CLEARING
  SYSTEM_PAYOUT_CLEARING
  BUYER_REAL_AVAILABLE
  BUYER_REAL_ESCROW_LOCKED
  WORKER_REAL_AVAILABLE
  WORKER_REAL_WITHDRAWAL_PENDING
}

enum PaymentProviderType {
  STRIPE
  PAYPAL
  SSLCOMMERZ
  SANDBOX_MOCK
}

enum PaymentOrderStatus {
  PENDING
  REQUIRES_PAYMENT_METHOD
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSED
  FAILED
  DUPLICATE_IGNORED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum WithdrawalMethodType {
  BANK_TRANSFER
  PAYONEER
  BKASH
  NAGAD
  ROCKET
  WISE
  BINANCE_PAY
}

enum EscrowFundingStatus {
  UNFUNDED
  PENDING_CONFIRMATION
  FUNDED_DEMO
  FUNDED_REAL
  PARTIALLY_REFUNDED
  REFUNDED
  SETTLED
}

// -------------------------------------------------------------
// USER & IDENTITY DOMAIN
// -------------------------------------------------------------

model User {
  id                   String        @id @default(uuid()) @db.Uuid
  email                String        @unique @db.VarChar(255)
  passwordHash         String        @db.VarChar(255)
  primaryRole          UserRole      @default(WORKER)
  status               UserStatus    @default(ACTIVE)
  emailVerified        Boolean       @default(false)
  mfaEnabled           Boolean       @default(false)
  mfaSecretEncrypted   String?       @db.VarChar(255)
  consecutiveFailures  Int           @default(0)
  lockedUntil          DateTime?     @db.Timestamptz(6)
  hasPendingPenalty    Boolean       @default(false)
  tokenVersion         Int           @default(1)
  lastReAuthAt         DateTime?     @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(6)

  profile              UserProfile?
  idvSubmissions       IdentityVerification[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens  PasswordResetToken[]
  createdTasks         Task[]                 @relation("BuyerTasks")
  participations       WorkerParticipation[]  @relation("WorkerParticipations")
  reviewsGiven         Review[]               @relation("ReviewsGiven")
  reviewsReceived      Review[]               @relation("ReviewsReceived")
  demoAccounts         DemoLedgerAccount[]
  realAccounts         RealLedgerAccount[]
  paymentOrders        PaymentOrder[]
  withdrawals          WithdrawalRequest[]
  conversations        ConversationParticipant[]
  sentMessages         Message[]
  notifications        Notification[]
  actorAuditLogs       AuditLog[]             @relation("ActorAuditLogs")
  uploadedEvidence     EvidenceFile[]         @relation("UploadedEvidence")
  disputesInitiated    Dispute[]              @relation("DisputesInitiated")

  @@index([status])
  @@index([email])
}

model UserProfile {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @db.Uuid
  displayName        String    @db.VarChar(100)
  headline           String?   @db.VarChar(150)
  bio                String?   @db.Text
  countryCode        String    @default("US") @db.VarChar(2) // ISO-3166-1 alpha-2
  avatarUrl          String?   @db.VarChar(512)
  hourlyRateCents    BigInt    @default(0)
  availabilityStatus String    @default("AVAILABLE") @db.VarChar(32)
  reputationScore    Decimal   @default(5.00) @db.Decimal(3, 2)
  completionRate     Decimal   @default(100.00) @db.Decimal(5, 2)
  totalReviewsCount  Int       @default(0)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills             UserSkill[]
}

model Skill {
  id        String      @id @default(uuid()) @db.Uuid
  name      String      @unique @db.VarChar(64)
  slug      String      @unique @db.VarChar(64)
  category  String      @db.VarChar(64)
  users     UserSkill[]
}

model UserSkill {
  profileId String      @db.Uuid
  skillId   String      @db.Uuid
  yearsExp  Int         @default(1)

  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill     Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
}

model IdentityVerification {
  id                    String     @id @default(uuid()) @db.Uuid
  userId                String     @db.Uuid
  countryCode           String     @db.VarChar(2)
  documentType          String     @db.VarChar(32)
  documentNumberMasked  String     @db.VarChar(32)
  identityDedupHash     String     @unique @db.VarChar(64)
  status                IdvStatus  @default(PENDING)
  providerReferenceId   String?    @db.VarChar(128)
  confidenceScore       Int?
  riskFlags             String[]
  rejectionReason       String?    @db.Text
  reviewerNotes         String?    @db.Text
  reviewedById          String?    @db.Uuid
  createdAt             DateTime   @default(now()) @db.Timestamptz(6)
  reviewedAt            DateTime?  @db.Timestamptz(6)

  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime  @db.Timestamptz(6)
  usedAt     DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime  @db.Timestamptz(6)
  usedAt     DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

// -------------------------------------------------------------
// TASK & CAPACITY DOMAIN (OPEN MARKETPLACE MULTI-WORKER)
// -------------------------------------------------------------

model Category {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @unique @db.VarChar(64)
  slug          String        @unique @db.VarChar(64)
  description   String?       @db.Text
  isActive      Boolean       @default(true)
  subcategories Subcategory[]
  tasks         Task[]
}

model Subcategory {
  id          String    @id @default(uuid()) @db.Uuid
  categoryId  String    @db.Uuid
  name        String    @db.VarChar(64)
  slug        String    @db.VarChar(64)
  isActive    Boolean   @default(true)

  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@unique([categoryId, slug])
}

model Task {
  id                      String                  @id @default(uuid()) @db.Uuid
  buyerId                 String                  @db.Uuid
  categoryId              String                  @db.Uuid
  subcategoryId           String                  @db.Uuid
  taskModel               TaskModel               @default(MULTI_WORKER)
  title                   String                  @db.VarChar(150)
  status                  TaskStatus              @default(DRAFT)
  totalSlots              Int                     @default(1)
  availableSlots          Int                     @default(1)
  unitBudgetCents         BigInt                  // in integer USD cents
  totalEscrowCents        BigInt                  // total reserved demo escrow in cents
  buyerFeeCents           BigInt                  // 2% platform surcharge in cents
  workerFeeCents          BigInt                  // 4% platform commission in cents
  maxRevisions            Int                     @default(2)
  startDeadlineHours      Int                     @default(6) // hours to initiate activity
  completionDurationHours Int                     @default(24) // total execution duration hours
  reviewSlaHours          Int                     @default(72) // 72-hour review SLA
  currentVersionNumber    Int                     @default(1)
  winningParticipationId String?                 @db.Uuid // for FIRST_APPROVED model
  escrowFundingStatus     EscrowFundingStatus     @default(UNFUNDED)
  createdAt               DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                @updatedAt @db.Timestamptz(6)

  buyer                   User                    @relation("BuyerTasks", fields: [buyerId], references: [id])
  category                Category                @relation(fields: [categoryId], references: [id])
  subcategory             Subcategory             @relation(fields: [subcategoryId], references: [id])
  instructionVersions     TaskInstructionVersion[]
  slots                   TaskSlot[]
  participations          WorkerParticipation[]
  conversations           Conversation[]
  reviews                 Review[]
  paymentOrders           PaymentOrder[]
  evidenceFiles           EvidenceFile[]

  @@index([status])
  @@index([categoryId, subcategoryId])
  @@index([createdAt])
}

model TaskSlot {
  id            String              @id @default(uuid()) @db.Uuid
  taskId        String              @db.Uuid
  slotNumber    Int
  isClaimed     Boolean             @default(false)
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)

  task          Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  participation WorkerParticipation?

  @@unique([taskId, slotNumber])
  @@index([taskId, isClaimed])
}

model TaskInstructionVersion {
  id                          String           @id @default(uuid()) @db.Uuid
  taskId                      String           @db.Uuid
  versionNumber               Int
  descriptionMarkdown         String           @db.Text
  acceptanceCriteriaJson      Json
  deliverableRequirementsJson  Json
  attachmentsJson             Json?
  createdById                 String           @db.Uuid
  createdAt                   DateTime         @default(now()) @db.Timestamptz(6)

  task                        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  participations              WorkerParticipation[]

  @@unique([taskId, versionNumber])
}

model WorkerParticipation {
  id                    String                  @id @default(uuid()) @db.Uuid
  taskId                String                  @db.Uuid
  slotId                String                  @unique @db.Uuid
  workerId              String                  @db.Uuid
  instructionVersionId  String                  @db.Uuid
  status                ParticipationStatus     @default(IN_PROGRESS)
  startDeadlineAt       DateTime                @db.Timestamptz(6)
  executionDeadlineAt   DateTime                @db.Timestamptz(6)
  submittedAt           DateTime?               @db.Timestamptz(6)
  reviewOverdueAt       DateTime?               @db.Timestamptz(6)
  approvedAt            DateTime?               @db.Timestamptz(6)
  revisionsUsed         Int                     @default(0)
  progressPercentage    Int                     @default(0) // derived strictly from verified milestones
  createdAt             DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(6)

  task                  Task                    @relation(fields: [taskId], references: [id])
  slot                  TaskSlot                @relation(fields: [slotId], references: [id])
  worker                User                    @relation("WorkerParticipations", fields: [workerId], references: [id])
  instructionVersion    TaskInstructionVersion  @relation(fields: [instructionVersionId], references: [id])
  milestones            ProgressMilestone[]
  submissions           Submission[]
  dispute               Dispute?
  review                Review?
  evidenceFiles         EvidenceFile[]

  @@index([taskId, status])
  @@index([workerId])
}

model ProgressMilestone {
  id                  String              @id @default(uuid()) @db.Uuid
  participationId     String              @db.Uuid
  milestoneOrder      Int
  title               String              @db.VarChar(120)
  description         String?             @db.Text
  isCompleted         Boolean             @default(false)
  isVerified          Boolean             @default(false)
  verifiedById        String?             @db.Uuid
  evidenceAttachments Json?
  completedAt         DateTime?           @db.Timestamptz(6)
  verifiedAt          DateTime?           @db.Timestamptz(6)

  participation       WorkerParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@unique([participationId, milestoneOrder])
}

model Submission {
  id                 String              @id @default(uuid()) @db.Uuid
  participationId    String              @db.Uuid
  currentVersion     Int                 @default(1)
  status             String              @default("PENDING_REVIEW") @db.VarChar(32)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)

  participation      WorkerParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  versions           SubmissionVersion[]
}

model SubmissionVersion {
  id                       String          @id @default(uuid()) @db.Uuid
  submissionId             String          @db.Uuid
  versionNumber            Int
  textNotes                String?         @db.Text
  deliverableUrlsJson      Json?
  fileAttachmentsJson      Json?
  criteriaAttestationsJson Json
  revisionNotes            String?         @db.Text
  submittedAt              DateTime        @default(now()) @db.Timestamptz(6)

  submission               Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  evidenceFiles            EvidenceFile[]

  @@unique([submissionId, versionNumber])
}

model Dispute {
  id                  String              @id @default(uuid()) @db.Uuid
  participationId     String              @unique @db.Uuid
  initiatorId         String              @db.Uuid
  status              DisputeStatus       @default(OPEN)
  reasonCode          String              @db.VarChar(64)
  statement           String              @db.Text
  assignedModeratorId String?             @db.Uuid
  verdict             String?             @db.VarChar(32)
  workerPayoutCents   BigInt?
  buyerRefundCents    BigInt?
  arbitrationNotes    String?             @db.Text
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  resolvedAt          DateTime?           @db.Timestamptz(6)

  participation       WorkerParticipation @relation(fields: [participationId], references: [id])
  initiator           User                @relation("DisputesInitiated", fields: [initiatorId], references: [id])
  evidenceFiles       EvidenceFile[]

  @@index([initiatorId])
  @@index([status])
}

model EvidenceFile {
  id                  String               @id @default(uuid()) @db.Uuid
  uploaderId          String               @db.Uuid
  participationId     String?              @db.Uuid
  submissionVersionId String?              @db.Uuid
  disputeId           String?              @db.Uuid
  taskId              String?              @db.Uuid
  originalFilename    String               @db.VarChar(255)
  storedFilename      String               @unique @db.VarChar(255)
  mimeType            String               @db.VarChar(128)
  sizeBytes           BigInt
  sha256Hash          String               @db.VarChar(64)
  storagePath         String               @db.Text
  isScannedClean      Boolean              @default(true)
  metadata            Json?
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)

  uploader            User                 @relation("UploadedEvidence", fields: [uploaderId], references: [id])
  participation       WorkerParticipation? @relation(fields: [participationId], references: [id], onDelete: Cascade)
  submissionVersion   SubmissionVersion?   @relation(fields: [submissionVersionId], references: [id], onDelete: SetNull)
  dispute             Dispute?             @relation(fields: [disputeId], references: [id], onDelete: SetNull)
  task                Task?                @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([uploaderId])
  @@index([participationId])
  @@index([disputeId])
  @@index([taskId])
}

model Review {
  id                  String              @id @default(uuid()) @db.Uuid
  taskId              String              @db.Uuid
  participationId     String              @unique @db.Uuid
  reviewerId          String              @db.Uuid
  revieweeId          String              @db.Uuid
  overallRating       Int                 // 1 to 5
  communicationRating Int                 // 1 to 5
  qualityRating       Int                 // 1 to 5
  timelinessRating    Int                 // 1 to 5
  publicComment       String              @db.Text
  privateFeedback     String?             @db.Text
  isPublished         Boolean             @default(false)
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  publishedAt         DateTime?           @db.Timestamptz(6)

  task                Task                @relation(fields: [taskId], references: [id])
  participation       WorkerParticipation @relation(fields: [participationId], references: [id])
  reviewer            User                @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee            User                @relation("ReviewsReceived", fields: [revieweeId], references: [id])
}

// -------------------------------------------------------------
// FINANCIAL DOMAIN (SIMULATED DOUBLE-ENTRY DEMO LEDGER)
// -------------------------------------------------------------

model DemoLedgerAccount {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String?            @db.Uuid
  accountType   DemoAccountType
  currency      String             @default("USD") @db.VarChar(3)
  balanceCents  BigInt             @default(0) // stored in integer USD cents
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)

  user          User?              @relation(fields: [userId], references: [id])
  debitEntries  DemoLedgerEntry[]  @relation("DebitDemoAccount")
  creditEntries DemoLedgerEntry[]  @relation("CreditDemoAccount")

  @@unique([userId, accountType, currency])
}

model DemoLedgerTransaction {
  id            String             @id @default(uuid()) @db.Uuid
  referenceType String             @db.VarChar(64) // e.g. "TASK_ESCROW_LOCK", "FAUCET_INJECTION"
  referenceId   String             @db.Uuid
  description   String             @db.Text
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)

  entries       DemoLedgerEntry[]

  @@index([referenceType, referenceId])
}

model DemoLedgerEntry {
  id                String                 @id @default(uuid()) @db.Uuid
  transactionId     String                 @db.Uuid
  debitAccountId    String                 @db.Uuid
  creditAccountId   String                 @db.Uuid
  amountCents       BigInt                 // stored in integer USD cents
  createdAt         DateTime               @default(now()) @db.Timestamptz(6)

  transaction       DemoLedgerTransaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  debitAccount      DemoLedgerAccount      @relation("DebitDemoAccount", fields: [debitAccountId], references: [id])
  creditAccount     DemoLedgerAccount      @relation("CreditDemoAccount", fields: [creditAccountId], references: [id])

  @@index([transactionId])
}

// -------------------------------------------------------------
// FINANCIAL DOMAIN (REAL INTERNATIONAL PAYMENTS & DOUBLE-ENTRY LEDGER)
// -------------------------------------------------------------

model RealLedgerAccount {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String?            @db.Uuid
  accountType   RealAccountType
  currency      String             @default("USD") @db.VarChar(3)
  balanceCents  BigInt             @default(0) // stored in integer minor currency units
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)

  user          User?              @relation(fields: [userId], references: [id])
  debitEntries  RealLedgerEntry[]  @relation("DebitRealAccount")
  creditEntries RealLedgerEntry[]  @relation("CreditRealAccount")

  @@unique([userId, accountType, currency])
  @@index([accountType])
}

model RealLedgerTransaction {
  id             String             @id @default(uuid()) @db.Uuid
  referenceType  String             @db.VarChar(64) // e.g. "BUYER_DEPOSIT", "TASK_ESCROW_LOCK", "SETTLEMENT_PAYOUT", "PLATFORM_COMMISSION", "REFUND", "WITHDRAWAL"
  referenceId    String             @db.Uuid
  idempotencyKey String?            @unique @db.VarChar(128)
  description    String             @db.Text
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)

  entries        RealLedgerEntry[]

  @@index([referenceType, referenceId])
}

model RealLedgerEntry {
  id                String                 @id @default(uuid()) @db.Uuid
  transactionId     String                 @db.Uuid
  debitAccountId    String                 @db.Uuid
  creditAccountId   String                 @db.Uuid
  amountCents       BigInt                 // stored in integer minor currency units
  createdAt         DateTime               @default(now()) @db.Timestamptz(6)

  transaction       RealLedgerTransaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  debitAccount      RealLedgerAccount      @relation("DebitRealAccount", fields: [debitAccountId], references: [id])
  creditAccount     RealLedgerAccount      @relation("CreditRealAccount", fields: [creditAccountId], references: [id])

  @@index([transactionId])
  @@index([debitAccountId])
  @@index([creditAccountId])
}

model PaymentOrder {
  id                   String              @id @default(uuid()) @db.Uuid
  buyerId              String              @db.Uuid
  taskId               String?             @db.Uuid
  provider             PaymentProviderType
  providerOrderId      String?             @db.VarChar(128) // e.g. Stripe pi_xxx, SSLCommerz tran_id, PayPal order_id
  providerClientSecret String?             @db.Text
  amountCents          BigInt              // USD minor currency units (cents)
  currency             String              @default("USD") @db.VarChar(3)
  chargedAmountMinor   BigInt?             // Amount in local payment currency (e.g. BDT poisha, EUR cents)
  chargedCurrency      String?             @db.VarChar(3)
  exchangeRate         Decimal?            @db.Decimal(12, 4)
  status               PaymentOrderStatus  @default(PENDING)
  idempotencyKey       String              @unique @db.VarChar(128)
  metadata             Json?
  failureReason        String?             @db.Text
  createdAt            DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(6)
  confirmedAt          DateTime?           @db.Timestamptz(6)

  buyer                User                @relation(fields: [buyerId], references: [id])
  task                 Task?               @relation(fields: [taskId], references: [id])

  @@index([buyerId])
  @@index([status])
  @@index([provider, providerOrderId])
}

model PaymentWebhookEvent {
  id              String                  @id @default(uuid()) @db.Uuid
  provider        PaymentProviderType
  eventId         String                  @db.VarChar(128) // unique provider event identifier
  eventType       String                  @db.VarChar(100)
  status          WebhookProcessingStatus @default(RECEIVED)
  payload         Json
  signatureHeader String?                 @db.Text
  processedAt     DateTime?               @db.Timestamptz(6)
  errorMessage    String?                 @db.Text
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@index([status])
}

model WithdrawalRequest {
  id                         String                @id @default(uuid()) @db.Uuid
  workerId                   String                @db.Uuid
  method                     WithdrawalMethodType
  destinationDetailsMasked   Json                  // masked destination, e.g. bank name + masked account or phone
  amountCents                BigInt                // USD minor currency units (cents)
  payoutCurrency             String                @default("USD") @db.VarChar(3)
  estimatedPayoutAmountMinor BigInt?
  exchangeRate               Decimal?              @db.Decimal(12, 4)
  status                     WithdrawalStatus      @default(PENDING)
  providerPayoutId           String?               @db.VarChar(128)
  rejectionReason            String?               @db.Text
  requestedAt                DateTime              @default(now()) @db.Timestamptz(6)
  processedAt                DateTime?             @db.Timestamptz(6)
  completedAt                DateTime?             @db.Timestamptz(6)

  worker                     User                  @relation(fields: [workerId], references: [id])

  @@index([workerId])
  @@index([status])
}

model CurrencyExchangeRate {
  id             String    @id @default(uuid()) @db.Uuid
  sourceCurrency String    @db.VarChar(3)
  targetCurrency String    @db.VarChar(3)
  rate           Decimal   @db.Decimal(12, 4)
  provider       String    @db.VarChar(64)
  effectiveAt    DateTime  @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([sourceCurrency, targetCurrency])
}

// -------------------------------------------------------------
// IN-PLATFORM MESSAGING & COLLABORATION
// -------------------------------------------------------------

model Conversation {
  id           String                    @id @default(uuid()) @db.Uuid
  taskId       String?                   @db.Uuid
  isPublicQnA  Boolean                   @default(false)
  createdAt    DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                  @updatedAt @db.Timestamptz(6)

  task         Task?                     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  joinedAt       DateTime     @default(now()) @db.Timestamptz(6)

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id              String       @id @default(uuid()) @db.Uuid
  conversationId  String       @db.Uuid
  senderId        String       @db.Uuid
  content         String       @db.Text
  attachmentsJson Json?
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// NOTIFICATIONS & AUDIT GOVERNANCE
// -------------------------------------------------------------

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String   @db.VarChar(64)
  title     String   @db.VarChar(150)
  body      String   @db.Text
  actionUrl String?  @db.VarChar(255)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AuditLog {
  id            String    @id @default(uuid()) @db.Uuid
  actorId       String    @db.Uuid
  actorRole     String    @db.VarChar(32)
  action        String    @db.VarChar(64)
  resourceType  String    @db.VarChar(64)
  resourceId    String    @db.Uuid
  previousState Json?
  newState      Json?
  ipAddress     String?   @db.VarChar(45)
  userAgent     String?   @db.Text
  reason        String?   @db.Text
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  actor         User      @relation("ActorAuditLogs", fields: [actorId], references: [id])

  @@index([resourceType, resourceId])
  @@index([actorId])
  @@index([createdAt])
}
