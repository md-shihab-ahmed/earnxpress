NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://earnxpress_admin:earnxpress_dev_secret@localhost:5432/earnxpress_db?schema=public

# Security & JWT Tokens
JWT_ACCESS_SECRET=dev_jwt_access_secret_earnxpress_min_32_chars_long_123!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_earnxpress_min_32_chars_long_456!
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=dev_cookie_secret_earnxpress_secure_789!

# Platform Fees (Proposed)
BUYER_FEE_PERCENTAGE=2.0
WORKER_FEE_PERCENTAGE=4.0
FAILURE_SURCHARGE_PERCENTAGE=2.0
FAILURE_SURCHARGE_ACTIVE=false

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Demo Faucet
DEMO_FAUCET_AMOUNT_CENTS=100000
